@page
@model RestaurantManagement.Web.Pages.Order.ResultModel
@{
    ViewData["Title"] = "Order Result";
}

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-8">
            <div class="card text-center">
                <div class="card-body text-center p-5">
                    <div class="mb-4">
                        <i class="fa-solid fa-circle-check fa-5x text-success"></i>
                    </div>

                    <h2 class="card-title text-success fw-bold">
                        Siparişiniz Alındı!
                    </h2>

                    <p class="card-text mt-3 fs-5 text-secondary">
                        Ödemeniz başarıyla tamamlandı ve siparişiniz <strong>mutfağa iletildi.</strong>
                        Şeflerimiz hazırlıklara hemen başlıyor!
                    </p>

                    <div class="alert alert-light border-0 bg-light mt-4">
                        <i class="fa-solid fa-clock text-primary"></i>
                        Tahmini hazırlanma süresi: <strong>15-20 dakika</strong>
                    </div>

                    <div class="d-grid gap-2 d-sm-flex justify-content-sm-center mt-4">
                        <a href="/" class="btn btn-outline-secondary btn-lg px-4">
                            Anasayfaya Dön
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
