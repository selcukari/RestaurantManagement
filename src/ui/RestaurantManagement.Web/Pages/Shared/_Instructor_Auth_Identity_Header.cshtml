@if (User.Identity!.IsAuthenticated)
{
    <ul class="navbar-nav ms-auto align-items-center">
        <li class="nav-item me-3 d-none d-sm-block">
            <a class="nav-link p-0 text-secondary" href="#">
                <i class="bi bi-bell fs-5"></i>
            </a>
        </li>

        <li class="nav-item dropdown">
            <a class="nav-link dropdown-toggle d-flex align-items-center py-0" href="#" id="userDropdown" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                <div class="avatar-circle me-2">
                    <span class="initials">@User.Identity.Name?[0].ToString().ToUpper()</span>
                </div>
                <span class="d-none d-md-inline">@User.Identity.Name</span>
            </a>

            <ul class="dropdown-menu dropdown-menu-end shadow border-0 mt-2" aria-labelledby="userDropdown">
                <li class="dropdown-header d-md-none">
                    <strong>@User.Identity.Name</strong>
                </li>
                <li>
                    <a class="dropdown-item py-2" asp-page="/auth/settings">
                        <i class="bi bi-person-gear me-2 text-muted"></i> Ayarlar
                    </a>
                </li>
                <li>
                    <a class="dropdown-item py-2" href="#">
                        <i class="bi bi-journal-text me-2 text-muted"></i> Ürünler
                    </a>
                </li>
                <li><hr class="dropdown-divider"></li>
                <li>
                    <form method="post" asp-page="/Auth/Logout" class="d-inline">
                        <button type="submit" class="dropdown-item py-2 text-danger">
                            <i class="bi bi-box-arrow-right me-2"></i> Çıkış Yap
                        </button>
                    </form>
                </li>
            </ul>
        </li>
    </ul>
}
else
{
    <ul class="navbar-nav ms-auto align-items-center">
        <li class="nav-item">
            <a class="nav-link fw-medium px-3" asp-page="/Auth/SignIn">Giriş Yap</a>
        </li>
        <li class="nav-item">
            <a class="btn btn-primary btn-sm px-4 rounded-pill shadow-sm" asp-page="/Auth/SignUp">Kayıt Ol</a>
        </li>
    </ul>
}

<style>
                        /* Avatar Dairesi Stilize */
.avatar-circle {
    width: 32px;
    height: 32px;
    background-color: #0d6efd; /* Temana uygun renk */
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    color: white;
    font-weight: bold;
    font-size: 0.85rem;
}

/* Dropdown menüsüne yumuşak bir geçiş ekler */
.dropdown-menu {
    border-radius: 10px;
    animation: fadeIn 0.2s ease;
}

@@keyframes fadeIn {
    from { opacity: 0; transform: translateY(10px); }
    to { opacity: 1; transform: translateY(0); }
}
</style>