<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Restauran.Web</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/RestaurantManagement.Web.styles.css" asp-append-version="true" />
</head>
<body>


    <partial name="_Instructor_Header_Dark" />


    <div class="container">

        <div class="row">

            <div class="col-md-9">
                @RenderBody()
            </div>
            <div class="col-md-3">


                <div class="list-group">
                    <a href="#" class="list-group-item list-group-item-action active" aria-current="true">
                        Menu
                    </a>
                    <a asp-page="/Instructor/Index" class="list-group-item list-group-item-action">Home Page</a>
                    <a asp-page="/Instructor/Products" class="list-group-item list-group-item-action">Product List</a>
                    <a asp-page="/Instructor/Tables" class="list-group-item list-group-item-action">Table List</a>
                    <a asp-page="/Instructor/Kitchen/Index" class="list-group-item list-group-item-action">Mutfak Sipariş Listesi</a>
                    <a asp-page="/Instructor/Reservations" class="list-group-item list-group-item-action">Rezervasyon Listesi</a>
                    <a asp-page="/Instructor/CreateTable" class="list-group-item list-group-item-action">Masa Oluştur</a>
                    <a asp-page="/Instructor/CreateProduct" class="list-group-item list-group-item-action">Create Products</a>
                    <a asp-page="/Customer/CreateReservation" class="list-group-item list-group-item-action">Create Reservation</a>
                </div>

            </div>
        </div>


    </div>

    <partial name="_Instructor_Footer" />


    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", false)
</body>
</html>