@page
@model RestaurantManagement.Web.Pages.Instructor.Kitchen.IndexModel
@{
    ViewData["Title"] = "Instructor Mutfak Sipariş Lis";
    Layout = "_Instructor_Layout";
}

<div class="container mt-5">
    <h2 class="mb-4">Mutfak Siparişleri</h2>


    @if (Model.KitchenList?.Any() != true)
    {
        <p class="text-muted">No orders found.</p>
        return;
    }


    <div class="accordion" id="orderHistoryAccordion">
        @foreach (var kitchen in Model.KitchenList)
        {
            var accordionId = $"accordion-{Guid.NewGuid()}";
            <div class="accordion-item">
                <h2 class="accordion-header" id="heading-@accordionId">
                    <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#collapse-@accordionId" aria-expanded="false" aria-controls="collapse-@accordionId">
                        Müşteri User: @kitchen.UserId | Sipariş Date: @kitchen.Created
                    </button>
                </h2>
                <div id="collapse-@accordionId" class="accordion-collapse collapse" aria-labelledby="heading-@accordionId" data-bs-parent="#orderHistoryAccordion">
                    <div class="accordion-body">
                        <table class="table table-striped">
                            <thead>
                                <tr>
                                    <th>Ürün Name</th>
                                    <th>Adet/Miktar</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var item in kitchen.GetItems)
                                {
                                    <tr>
                                        <td>@item.Name</td>
                                        <td>@item.Quantity</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        }
    </div>

</div>
