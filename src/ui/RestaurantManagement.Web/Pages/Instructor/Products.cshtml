@page
@model RestaurantManagement.Web.Pages.Instructor.ProductModel
@{
    ViewData["Title"] = "Instructor Products";
    Layout = "_Instructor_Layout";
}

<table class="table table-striped">
    <thead>
        <tr>
            <th scope="col">#</th>
            <td>Picture</td>
            <th scope="col">Name</th>
            <th scope="col">Edet/Miktar</th>
            <th scope="col">Description</th>
            <th scope="col">Price</th>
            <th scope="col">Category Name</th>
            <th scope="col">Puan</th>
            <th scope="col">Calorie</th>
            <th scope="col">Actions</th>
        </tr>
    </thead>
    <tbody>
        @if (Model.ProductViewModels.Any())
        {
            var index = 1;
            foreach (var product in Model.ProductViewModels)
            {
                <tr>
                    <th scope="row">@index</th>
                    <td>
                        <product-thumbnail-picture with="100px" class="img-fluid img-thumbnail" src="@product.ImageUrl"></product-thumbnail-picture>
                    </td>
                    <td>@product.Name</td>
                    <td>@product.Quantity</td>
                    <td>@product.TruncateDescription(100)</td>
                    <td>@product.Price.ToString("C")</td>
                    <td>@product.MenuName</td>
                    <td>@product.Rating</td>
                    <td>@product.Calorie</td>
                    <td>
                        <div class="btn-group" role="group">
                            <a asp-page="Update" asp-route-id="@product.Id" class="btn btn-sm btn-primary">Güncelle</a>
                            <a asp-page-handler="Delete" asp-route-id="@product.Id" class="btn btn-sm btn-danger">Sil</a>
                        </div>
                    </td>
                </tr>
                index++;
            }
        }
        else
        {
            <tr>
                <td colspan="10" class="text-center">No courses available.</td>
            </tr>
        }
    </tbody>
</table>
