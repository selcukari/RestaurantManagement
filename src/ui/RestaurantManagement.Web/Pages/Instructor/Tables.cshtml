@page
@model RestaurantManagement.Web.Pages.Instructor.TablesModel
@{
    ViewData["Title"] = "Instructor Tables";
    Layout = "_Instructor_Layout";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="fw-bold"><i class="bi bi-grid-3x3-gap"></i> Restoran Masaları</h2>
        <button class="btn btn-primary" asp-page="/Instructor/CreateTable">
            <i class="bi bi-plus-circle"></i> Yeni Masa Ekle
        </button>
    </div>

    <div class="row row-cols-1 row-cols-md-2 row-cols-lg-3 g-4">
        @foreach (var table in Model.TableViewModels)
        {
            <div class="col">
                <div class="card h-100 shadow-sm border-0 transition-hover">
                    <div class="card-header bg-white border-0 pt-3 d-flex justify-content-between">
                        <span class="badge @GetStatusClass(table.Status)">
                            @table.Status
                        </span>
                        <small class="text-muted">#@table.TableNumber</small>
                    </div>

                    <div class="card-body text-center">
                        <i class="bi bi-house-door display-4 text-secondary mb-3"></i>
                        <h5 class="card-title fw-bold">Masa @table.TableNumber</h5>
                        <p class="card-text text-muted">
                            <i class="bi bi-people-fill"></i> Kapasite: @table.Capacity Kişi
                        </p>
                        <div class="d-flex justify-content-center align-items-center gap-2">
                            <span class="badge bg-light text-dark border">
                                <i class="bi bi-geo-alt"></i> @table.Location
                            </span>
                        </div>
                    </div>

                    <div class="card-footer bg-light border-0 d-flex justify-content-around py-3">
                        <button class="btn btn-sm btn-outline-primary w-100 me-1">Düzenle</button>
                        <button class="btn btn-sm btn-outline-danger w-100">Sil</button>
                    </div>
                </div>
            </div>
        }
    </div>
</div>

@functions {
    // Statüye göre renk belirleyen yardımcı metod
    public string GetStatusClass(string status)
    {
        return status.ToLower() switch
        {
            "empty" or "boş" => "bg-success",
            "occupied" or "dolu" => "bg-danger",
            "reserved" or "rezerve" => "bg-warning text-dark",
            _ => "bg-secondary"
        };
    }
}

<style>
    .transition-hover:hover {
        transform: translateY(-5px);
        transition: all 0.3s ease;
        box-shadow: 0 10px 20px rgba(0,0,0,0.1) !important;
    }
    .card { border-radius: 15px; overflow: hidden; }
</style>
