@page
@model RestaurantManagement.Web.Pages.Instructor.CreateProductModel
@{
    ViewData["Title"] = "Instructor Create";
    Layout = "_Instructor_Layout";
}

<div class="row">
    
    <h2>Create Course</h2>
    <div asp-validation-summary="ModelOnly" class="alert alert-warning text-bg-warning   border-warning"></div>
    <form method="post" enctype="multipart/form-data">
        <div class="mb-3">
            <label asp-for="ViewModel.MenuDropdownList" class="form-label"></label>
            <select asp-for="ViewModel.MenuId" class="form-select" asp-items="@Model.ViewModel.MenuDropdownList">
                <option value="">Select Category</option>
            </select>
            <span asp-validation-for="ViewModel.MenuId" class="text-danger"></span>
        </div>
        <div class="mb-3">
            <label asp-for="ViewModel.Name" class="form-label"></label>
            <input asp-for="ViewModel.Name" class="form-control">
            <span asp-validation-for="ViewModel.Name" class="text-danger"></span>
        </div>
        <div class="mb-3">
            <label asp-for="ViewModel.Description" class="form-label"></label>
            <textarea asp-for="ViewModel.Description" class="form-control"></textarea>
            <span asp-validation-for="ViewModel.Description" class="text-danger"></span>
        </div>


        <div class="mb-3">
            <label asp-for="ViewModel.PictureFormFile" class="form-label"></label>
            <input asp-for="ViewModel.PictureFormFile" class="form-control" type="file">
            <span asp-validation-for="ViewModel.PictureFormFile" class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label asp-for="ViewModel.Price" class="form-label"></label>
            <input asp-for="ViewModel.Price" class="form-control" type="number" step="1">
            <span asp-validation-for="ViewModel.Price" class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label asp-for="ViewModel.Quantity" class="form-label"></label>
            <input asp-for="ViewModel.Quantity" class="form-control" type="number" min="1" step="1">
            <span asp-validation-for="ViewModel.Quantity" class="text-danger"></span>
        </div>

        <button type="submit" class="btn btn-primary">Create Product</button>
    </form>
</div>


@section Scripts {
    @{
        await Html.RenderPartialAsync("Shared/_ValidationScriptsPartial");
    }
}